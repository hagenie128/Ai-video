{
  "id": "emotional_story",
  "label": "emotional_story (스토리텔링/후기)",
  "description": "긴 호흡의 컷 / 부드러운 움직임 / 따뜻한 톤 / 감성 BGM",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "cut_rules": {
    "first": 1.5,
    "normal": 2.3,
    "detail": 1.3,
    "first_range": [
      1.2,
      1.8
    ],
    "normal_range": [
      1.8,
      3.0
    ],
    "detail_range": [
      1.0,
      1.6
    ]
  },
  "default_image_effect": "slow_zoom_in",
  "image_effect_cycle": [
    "slow_zoom_in",
    "slow_zoom_out",
    "pan_left_to_right",
    "subtle_shake"
  ],
  "default_video_effect": "none",
  "transition": "hardcut",
  "video": {
    "saturation": 0.95,
    "contrast": 1.06,
    "brightness": 0.01,
    "grain": 6
  },
  "subtitle": {
    "mode": "cut",
    "font": "Malgun Gothic",
    "font_size": 66,
    "max_chars": 16,
    "bold": true,
    "primary_color": "#FFFFFF",
    "outline_color": "#000000",
    "outline": 5,
    "shadow": 2,
    "margin_v": 360,
    "align": "center"
  },
  "audio": {
    "voice_volume": 1.0,
    "bgm_volume": 0.18,
    "sfx_volume": 0.45,
    "ducking": true,
    "duck_threshold": 0.045,
    "duck_ratio": 9.0,
    "duck_attack": 15.0,
    "duck_release": 380.0,
    "fade_in": 0.0,
    "fade_out": 0.0,
    "black_tail": 0.8
  },
  "hard_cuts_only": true,
  "first_3s_min_cuts": 3
}
