{
  "id": "fast_comparison",
  "label": "fast_comparison (빠른 비교 분석)",
  "description": "아주 짧은 컷 / 좌우 팬으로 비교 강조 / 대비 강한 톤",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "cut_rules": {
    "first": 1.0,
    "normal": 1.2,
    "detail": 0.7,
    "first_range": [
      0.7,
      1.2
    ],
    "normal_range": [
      0.9,
      1.5
    ],
    "detail_range": [
      0.6,
      0.9
    ]
  },
  "default_image_effect": "pan_left_to_right",
  "image_effect_cycle": [
    "pan_left_to_right",
    "pan_right_to_left",
    "fast_zoom_in",
    "slow_zoom_in"
  ],
  "default_video_effect": "none",
  "transition": "hardcut",
  "video": {
    "saturation": 0.9,
    "contrast": 1.2,
    "brightness": 0.0,
    "grain": 2
  },
  "subtitle": {
    "mode": "cut",
    "font": "Malgun Gothic",
    "font_size": 76,
    "max_chars": 13,
    "bold": true,
    "primary_color": "#FFFFFF",
    "outline_color": "#000000",
    "outline": 6,
    "shadow": 2,
    "margin_v": 300,
    "align": "center"
  },
  "audio": {
    "voice_volume": 1.0,
    "bgm_volume": 0.13,
    "sfx_volume": 0.75,
    "ducking": true,
    "duck_threshold": 0.045,
    "duck_ratio": 9.0,
    "duck_attack": 15.0,
    "duck_release": 380.0,
    "fade_in": 0.0,
    "fade_out": 0.0,
    "black_tail": 0.8
  },
  "hard_cuts_only": true,
  "first_3s_min_cuts": 4
}
