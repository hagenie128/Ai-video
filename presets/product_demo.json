{
  "id": "product_demo",
  "label": "product_demo (제품 소개/사용법)",
  "description": "제품을 차분히 보여주는 구성 / 느린 확대 / 고급스러운 톤",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "cut_rules": {
    "first": 1.4,
    "normal": 2.0,
    "detail": 1.1,
    "first_range": [
      1.0,
      1.6
    ],
    "normal_range": [
      1.5,
      2.5
    ],
    "detail_range": [
      0.8,
      1.3
    ]
  },
  "default_image_effect": "slow_zoom_in",
  "image_effect_cycle": [
    "slow_zoom_in",
    "slow_zoom_out",
    "pan_right_to_left",
    "slow_zoom_in"
  ],
  "default_video_effect": "none",
  "transition": "hardcut",
  "video": {
    "saturation": 1.02,
    "contrast": 1.08,
    "brightness": 0.0,
    "grain": 0
  },
  "subtitle": {
    "mode": "cut",
    "font": "Malgun Gothic",
    "font_size": 68,
    "max_chars": 15,
    "bold": true,
    "primary_color": "#FFFFFF",
    "outline_color": "#000000",
    "outline": 5,
    "shadow": 2,
    "margin_v": 340,
    "align": "center"
  },
  "audio": {
    "voice_volume": 1.0,
    "bgm_volume": 0.16,
    "sfx_volume": 0.5,
    "ducking": true,
    "duck_threshold": 0.045,
    "duck_ratio": 9.0,
    "duck_attack": 15.0,
    "duck_release": 380.0,
    "fade_in": 0.0,
    "fade_out": 0.0,
    "black_tail": 0.8
  },
  "hard_cuts_only": true,
  "first_3s_min_cuts": 3
}
