{
  "id": "clean_info",
  "label": "clean_info (깔끔한 정보형)",
  "description": "밝고 깨끗한 톤 / 빠른 하드컷 / 정보 전달 중심 / 자막 가독성 우선",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "cut_rules": {
    "first": 1.2,
    "normal": 1.6,
    "detail": 0.9,
    "first_range": [
      0.8,
      1.4
    ],
    "normal_range": [
      1.2,
      2.0
    ],
    "detail_range": [
      0.6,
      1.0
    ]
  },
  "default_image_effect": "slow_zoom_in",
  "image_effect_cycle": [
    "slow_zoom_in",
    "pan_left_to_right",
    "slow_zoom_out",
    "pan_right_to_left"
  ],
  "default_video_effect": "none",
  "transition": "hardcut",
  "video": {
    "saturation": 1.0,
    "contrast": 1.05,
    "brightness": 0.01,
    "grain": 0
  },
  "subtitle": {
    "mode": "cut",
    "font": "Malgun Gothic",
    "font_size": 70,
    "max_chars": 15,
    "bold": true,
    "primary_color": "#FFFFFF",
    "outline_color": "#111111",
    "outline": 5,
    "shadow": 1,
    "margin_v": 320,
    "align": "center"
  },
  "audio": {
    "voice_volume": 1.0,
    "bgm_volume": 0.14,
    "sfx_volume": 0.6,
    "ducking": true,
    "duck_threshold": 0.045,
    "duck_ratio": 9.0,
    "duck_attack": 15.0,
    "duck_release": 380.0,
    "fade_in": 0.0,
    "fade_out": 0.0,
    "black_tail": 0.8
  },
  "hard_cuts_only": true,
  "first_3s_min_cuts": 3
}
