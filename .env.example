# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# 앱의 "8. AI 연동 설정" 화면에서 입력해도 같은 파일에 저장됩니다.
# Windows 환경변수로 등록해도 됩니다 (환경변수가 .env 보다 우선).

# 대본 생성용 LLM (하나만 있으면 됩니다. 없어도 규칙 기반으로 동작합니다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 한국어 TTS (기본값 Edge TTS 는 키가 필요 없습니다)
ELEVENLABS_API_KEY=

# Higgsfield 는 API 키를 쓰지 않습니다. CLI 로그인으로 인증합니다:
#   npm i -g @higgsfield/cli
#   higgsfield auth login
